{
  "schema_version": 1,
  "profile": "lite",
  "authority": {
    "core": {
      "repository": "sink6985757-web/cross-device-agent-workflow-core",
      "revision": "0000000000000000000000000000000000000000"
    },
    "lifecycle": {
      "repository": "sink6985757-web/cross-device-agent-skills",
      "revision": "0000000000000000000000000000000000000000"
    },
    "readygate": {
      "repository": "sink6985757-web/readygate-skill-chatgpt-app",
      "revision": "0000000000000000000000000000000000000000"
    }
  },
  "routing": {
    "part": "part-example",
    "project": "project-example",
    "project_root": "."
  },
  "project": {
    "github_repository": "example/project",
    "remote": "origin",
    "default_branch": "main",
    "project_kind": "mixed"
  },
  "paths": {
    "agents": "AGENTS.md",
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "handoff": "handoff.md",
    "manifest": ".agents/project-lifecycle.json"
  },
  "content": {
    "tracked_roots": ["."],
    "excluded_roots": [".git", ".env", "private", "raw"],
    "large_file_policy": "repository-default"
  },
  "checkpoint": {
    "mode": "manual",
    "initial": "push-bootstrap",
    "startup": "fetch-and-verify",
    "shutdown": "commit-and-push-current-branch",
    "branch_policy": "current-work-branch",
    "readback": "remote-sha",
    "force_push": false,
    "pull_mode": "ff-only",
    "unknown_untracked": "stop",
    "allow_paths": [
      ".agents/project-lifecycle.json",
      "AGENTS.md",
      "README.md",
      "CHANGELOG.md",
      "handoff.md"
    ],
    "forbidden_actions": [
      "create-repository",
      "force-push",
      "auto-merge-or-rebase",
      "tag-or-release",
      "merge-pull-request",
      "delete-or-archive",
      "change-permissions"
    ]
  },
  "device_binding": {
    "mode": "runtime-only",
    "local_policy": "policy.local.yaml"
  },
  "rollback": {
    "published_change": "git-revert",
    "inspect_old_revision": "restore-branch",
    "behind_clean": "pull-ff-only",
    "diverged": "stop-preserve-refs",
    "clone_target": "empty-directory-only"
  }
}
