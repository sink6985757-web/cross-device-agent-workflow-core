{
  "schema_version": 1,
  "core_version": "0.2.0",
  "documentation_profile": "two-tier-lite-default",
  "profiles": {
    "lite": {
      "purpose": "Low-token project lifecycle",
      "daily_read_surface": [
        "AGENTS.md",
        "handoff.md",
        "git status"
      ],
      "required_skills": [
        "initial",
        "startup",
        "shutdown"
      ],
      "canonical_delivery": "external-pinned"
    },
    "full": {
      "purpose": "First-device bootstrap and governed workflows",
      "daily_read_surface": [
        "AGENTS.md",
        "handoff.md"
      ],
      "required_skills": [
        "initial",
        "startup",
        "shutdown",
        "readygate"
      ],
      "canonical_delivery": "this-repository"
    }
  },
  "dependencies": {
    "lite_three_skills": {
      "version": "v2.0.0",
      "last_public_version": "v1.1.1",
      "delivery_status": "SOURCE_CHECKPOINT_VERIFIED",
      "source": "https://github.com/sink6985757-web/cross-device-agent-skills",
      "runtime_path": "~/.agents/skills",
      "required_skills": [
        "initial",
        "startup",
        "shutdown"
      ],
      "revision": "7a377045b613ed4b9b1e7e5a17c1251dbd213ddf"
    },
    "readygate": {
      "version": "v0.2.1",
      "source": "https://github.com/sink6985757-web/readygate-skill-chatgpt-app",
      "runtime_path": "~/.agents/skills/readygate",
      "revision": "b7756661c98b69ca8766bfdfec833eb54ff74b4c"
    },
    "project_lifecycle_manifest": {
      "schema_version": 1,
      "schema": ".schemas/project-lifecycle.schema.json",
      "template": "templates/project-lifecycle.template.json",
      "validator": "scripts/project_lifecycle.py",
      "deployed_path": ".agents/project-lifecycle.json"
    }
  },
  "allowed_statuses": [
    "IMPLEMENTED",
    "PROMPT_ONLY",
    "PLANNED"
  ],
  "features": [
    {
      "id": "bootstrap-advisor",
      "status": "IMPLEMENTED",
      "profile": "full",
      "entry": "scripts/install.ps1",
      "writes": false
    },
    {
      "id": "bootstrap-apply",
      "status": "PLANNED",
      "profile": "full",
      "entry": "BOOTSTRAP.md#6-寫入與回復",
      "writes": true
    },
    {
      "id": "repository-validation",
      "status": "IMPLEMENTED",
      "profile": "full",
      "entry": "scripts/validate.ps1",
      "writes": false
    },
    {
      "id": "project-four-file-contract",
      "status": "IMPLEMENTED",
      "profile": "lite",
      "entry": "README.md#專案四檔契約",
      "writes": "initial-and-shutdown-only"
    },
    {
      "id": "lite-project-lifecycle",
      "status": "IMPLEMENTED",
      "profile": "lite",
      "entry": "external:lite_three_skills",
      "writes": "initial-and-shutdown-only"
    },
    {
      "id": "readygate-integration",
      "status": "IMPLEMENTED",
      "profile": "on-demand",
      "entry": "WORKFLOW.md#readygate-橫向閘門",
      "writes": "per-confirmed-work-order"
    },
    {
      "id": "ten-capability-sop",
      "status": "IMPLEMENTED",
      "profile": "on-demand",
      "entry": "WORKFLOW.md",
      "writes": "per-section-policy"
    },
    {
      "id": "portable-project-lifecycle-manifest",
      "status": "IMPLEMENTED",
      "profile": "lite-and-full",
      "entry": "scripts/project_lifecycle.py",
      "writes": false
    },
    {
      "id": "legacy-project-migration",
      "status": "PROMPT_ONLY",
      "profile": "full",
      "entry": "MAINTAINERS.md#舊專案套用",
      "writes": "approval-required"
    },
    {
      "id": "external-knowledge-on-demand",
      "status": "PROMPT_ONLY",
      "profile": "on-demand",
      "entry": "WORKFLOW.md#6-pluginsapps-mcp-跨工具工作流",
      "writes": "explicit-independent-task-only"
    }
  ]
}
